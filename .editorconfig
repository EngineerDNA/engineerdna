# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Go module files
[go.{mod,sum}]
indent_style = tab
indent_size = 4

# JavaScript, TypeScript, JSX, TSX
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_style = space
indent_size = 2

# JSON with comments (tsconfig, etc.)
[{tsconfig,*.jsonc}*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Python scripts (for hooks)
[*.py]
indent_style = space
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab
indent_size = 4

[*.mk]
indent_style = tab
indent_size = 4

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Docker files
[Dockerfile*]
indent_style = space
indent_size = 2

# Docker Compose files
[docker-compose*.yml]
indent_style = space
indent_size = 2

# GitHub Actions workflows
[.github/workflows/*.yml]
indent_style = space
indent_size = 2

# Package manager files
[{package,package-lock}.json]
indent_style = space
indent_size = 2

# Config files
[*.{toml,ini}]
indent_style = space
indent_size = 2

# CSS, SCSS, PostCSS
[*.{css,scss,pcss}]
indent_style = space
indent_size = 2

# HTML files
[*.html]
indent_style = space
indent_size = 2

# Git config
[.gitattributes]
indent_style = space
indent_size = 2

[.gitignore]
indent_style = space
indent_size = 2

# Claude Code config
[.claude/**]
indent_style = space
indent_size = 2

# Environment files
[.env*]
indent_style = space
indent_size = 2
