{
  "name": "ollama-insights",
  "version": "0.1.0",
  "type": "processor",
  "description": "AI-powered insights using local Ollama models",
  "author": "EngineerDNA",
  "config_fields": [
    {
      "name": "endpoint",
      "type": "string",
      "required": false,
      "description": "Ollama API endpoint (e.g., http://localhost:11434)",
      "default": "http://localhost:11434",
      "secret": false
    },
    {
      "name": "model",
      "type": "string",
      "required": false,
      "description": "Model name (e.g., llama3, mistral, codellama)",
      "default": "llama3",
      "secret": false
    }
  ],
  "anonymization": {
    "required": true,
    "reason": "Data sent to AI model for analysis",
    "strategy": "sequential",
    "fields": ["actor", "author", "assignee", "email", "name"]
  },
  "capabilities": [
    "weekly_summary",
    "anomaly_detection",
    "recommendations"
  ]
}
