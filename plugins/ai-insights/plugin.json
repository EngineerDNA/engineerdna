{
  "name": "ai-insights",
  "version": "1.0.0",
  "type": "processor",
  "description": "AI-powered metrics analysis",
  "author": "EngineerDNA",
  "config_fields": [
    {
      "name": "provider",
      "type": "select",
      "options": ["anthropic", "openai", "ollama"],
      "required": true,
      "description": "AI provider",
      "secret": false
    },
    {
      "name": "api_key",
      "type": "password",
      "required": true,
      "description": "Your API key (BYOK)",
      "secret": true
    },
    {
      "name": "model",
      "type": "string",
      "required": false,
      "description": "Model name (e.g., claude-sonnet-4, gpt-4)",
      "default": "claude-sonnet-4",
      "secret": false
    },
    {
      "name": "endpoint",
      "type": "string",
      "required": false,
      "description": "For Ollama: http://localhost:11434",
      "secret": false
    }
  ],
  "anonymization": {
    "required": true,
    "reason": "Data sent to external AI API",
    "strategy": "sequential",
    "fields": ["actor", "author", "assignee", "email", "name"]
  },
  "capabilities": [
    "weekly_summary",
    "anomaly_detection",
    "recommendations"
  ]
}
